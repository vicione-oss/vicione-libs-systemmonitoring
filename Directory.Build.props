<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Eigenschaften für alle Projekte des Repos -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <!-- Allgemeine Informationen -->
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers Condition="$(MSBuildProjectDirectory.Contains('src'))">linux-x64;linux-arm64;win-x64</RuntimeIdentifiers>
    <Description>-</Description>
    <Product>ViciOne</Product>
    <Company>ViciOne open automation gmbh</Company>
    <Year>$([System.DateTime]::Now.Year)</Year>
    <Copyright>Copyright © $(Company) $(Year)</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    <!-- Codequalität erhöhen -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);EnableGenerateDocumentationFile</NoWarn> <!-- Workaround for https://github.com/dotnet/roslyn/issues/41640 -->
    <!-- NuGet Lock File -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <!-- Für Repos die Projekte enthalten die als NuGet Paket veröffentlicht werden -->
  <PropertyGroup>
    <!-- https://docs.microsoft.com/de-de/nuget/reference/msbuild-targets -->
    <PackageProjectUrl>https://gitlab.com/vicione-oss/vicione/suite/systemmonitoring</PackageProjectUrl>
    <Authors>$(Company)</Authors>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectDirectory.Contains('src'))">
    <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" /> <!-- NSubstitute -->
  </ItemGroup>

  <!-- Testprojekte sollen beim Veröffentlichen ignoriert und nicht als NuGet-Paket verpackt werden -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('tests'))">
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner> <!-- Microsoft Testing Platform command line experience -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- Beispielprojekte sollen beim Veröffentlichen ignoriert und nicht als NuGet-Paket verpackt werden -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('samples'))">
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>
</Project>
