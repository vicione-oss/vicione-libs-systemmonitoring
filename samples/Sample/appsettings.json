{
    "Monitoring": {
        "ClusterNodeId": "my-node",
        "NodeType": "DefaultDebian",
        "EnabledMetrics": {
            "Cpu": true,
            "Ram": true,
            "Disk": true,
            "Network": true,
            "Swap": true,
            "Thermal_Sensors": true,
            "Uptime": true,
            "Process": true,
            "Processor": true
        },
